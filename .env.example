# ==============================================================================
# SGP-II Environment Variables Configuration
# ==============================================================================
# Copy this file to .env and customize values for your environment.
# The .env file is gitignored for security — NEVER commit it.
# ==============================================================================

# ==================== API KEYS (SENSITIVE — REQUIRED) ====================
# Google Gemini API Key (Primary LLM for sentiment analysis)
# Obtain from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Groq API Key (Fallback LLM for sentiment analysis)
# Obtain from: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# ==================== DATABASE CONFIGURATION ====================
# Database dialect: 'sqlite' (local dev) or 'postgres' (cloud/Neon)
DB_TYPE=sqlite
# Connection string — SQLite default uses local file, Postgres example:
# DB_URL=postgresql://user:password@host:5432/sgp2
DB_URL=sqlite:///data/sgp2.db

# ==================== TRADING CONFIGURATION ====================
# Stock Ticker Symbol (NSE format: SYMBOL.NS, US: SYMBOL)
TICKER=AAPL
# Backtest Date Range (YYYY-MM-DD format)
START_DATE=2020-01-01
END_DATE=2024-01-01
# Portfolio Configuration
INITIAL_CASH=100000.0
COMMISSION=0.001

# ==================== STRATEGY PARAMETERS ====================
# Golden Cross Strategy (SMA crossover)
GOLDEN_CROSS_FAST=50
GOLDEN_CROSS_SLOW=200
# RSI Mean Reversion Strategy
RSI_PERIOD=14
RSI_OVERSOLD=30.0
RSI_OVERBOUGHT=70.0
# MACD Trend Following Strategy
MACD_FAST=12
MACD_SLOW=26
MACD_SIGNAL=9

# ==================== SIGNAL GENERATOR THRESHOLDS ====================
# Minimum sentiment score for BUY signal confirmation
SENTIMENT_THRESHOLD=0.2
# Minimum P(BUY) probability from ML model for BUY signal
PROB_BUY_THRESHOLD=0.65
# Forward return threshold for target generation (e.g., 0.02 = 2%)
FORWARD_RETURN_PCT=0.02
# Forward return lookback window in trading days
FORWARD_RETURN_DAYS=5

# ==================== MODEL CONFIGURATION ====================
# Path to serialized ML model artifact (relative to project root)
MODEL_PATH=models/xgboost_signal_v1.pkl

# ==================== LOGGING ====================
# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# ==================== LLM CONFIGURATION ====================
# Primary LLM provider for sentiment analysis: 'gemini' or 'groq'
LLM_PRIMARY_PROVIDER=gemini
# Gemini model identifier
GEMINI_MODEL=gemini-2.0-flash
# Groq model identifier
GROQ_MODEL=llama-3.1-8b-instant
